{
  "name": "malevich",
  "version": "0.2.0",
  "description": "Terminal plotting for JavaScript: a small grammar of marks, honest axes, millions of points. WASM-backed, Ink-ready.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shergin/malevich.git",
    "directory": "js"
  },
  "homepage": "https://github.com/shergin/malevich/tree/main/js",
  "bugs": {
    "url": "https://github.com/shergin/malevich/issues"
  },
  "keywords": [
    "plot",
    "chart",
    "terminal",
    "ascii",
    "visualization",
    "wasm",
    "ink",
    "tui",
    "cli",
    "braille"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ink": {
      "types": "./dist/ink/index.d.ts",
      "import": "./dist/ink/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/ink",
    "generated",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:wasm": "wasm-pack build native --target nodejs --out-dir ../generated --release && rm -f generated/.gitignore generated/README.md generated/.npmignore && printf '%s\\n' '{\"type\":\"commonjs\"}' > generated/package.json",
    "build:ts": "tsc && mkdir -p dist/generated && cp generated/*.js generated/*.wasm generated/*.d.ts dist/generated/ 2>/dev/null || true",
    "build": "npm run build:wasm && npm run build:ts",
    "test": "tsx --test src/test/*.test.ts",
    "example": "node examples/hello.mjs",
    "showcase": "tsx examples/showcase.ts",
    "example:loss": "tsx examples/loss.ts",
    "example:languages": "tsx examples/languages.ts",
    "example:distribution": "tsx examples/distribution.ts",
    "example:ink": "tsx examples/ink-hello.tsx",
    "example:zoom": "tsx examples/ink-zoom.tsx",
    "example:linked": "tsx examples/ink-linked.tsx",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "ink": ">=5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "ink": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "ink": "^6.1.0",
    "react": "^19.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
